---
import Base from "../layouts/Base.astro";
import IncidentRows from "../components/IncidentRows.astro";
import { site } from "../data/status";
import { sortedIncidents } from "../lib/status";

const months = new Map<string, typeof sortedIncidents>();
for (const i of sortedIncidents) {
  const key = new Date(i.startedAt).toLocaleDateString("en-US", { month: "long", year: "numeric", timeZone: "UTC" });
  months.set(key, [...(months.get(key) ?? []), i]);
}
---

<Base title="Incident history" description={`Every incident and maintenance window on ${site.name}, newest first.`}>
  <div class="wrap">
    <header class="head">
      <h1>Incident history</h1>
      <p>Every incident and maintenance window, newest first. Each one links to its full timeline of updates.</p>
    </header>
    {
      [...months.entries()].map(([month, list]) => (
        <section class="section" aria-label={month}>
          <div class="section-title">
            <h2>{month}</h2>
            <span class="count">
              {list.length} {list.length === 1 ? "entry" : "entries"}
            </span>
          </div>
          <IncidentRows incidents={list} />
        </section>
      ))
    }
  </div>
</Base>

<style>
  .head {
    padding-top: 48px;
    display: grid;
    gap: 8px;
  }
  h1 {
    font-size: clamp(26px, 4vw, 32px);
    letter-spacing: -0.01em;
  }
  .head p {
    color: var(--text-2);
    max-width: 36rem;
  }
  .count {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }
</style>
